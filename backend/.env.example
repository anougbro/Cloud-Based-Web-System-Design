# Secrets. Every value here is read by app.security or app.database at boot.
# Copy to .env and fill in. Never commit the filled file.

# REQUIRED. The app refuses to start without it, rather than falling back to a
# value published in the repository. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# REQUIRED in production. SQLite is the default for local development only.
#   local:  sqlite:///./pocketwise.db
#   Render: postgresql://user:pass@host/db   (injected by the blueprint)
DATABASE_URL=sqlite:///./pocketwise.db

# Comma-separated. Whitespace around values is stripped, so "a, b" works.
CORS_ORIGINS=http://localhost:5173

# Comma-separated. Leave empty to disable the TrustedHost check in development.
ALLOWED_HOSTS=

# production disables /docs, /redoc and /openapi.json.
ENVIRONMENT=development

LOG_LEVEL=INFO